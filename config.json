{
  "_comment": "Configuración del sistema de avatar pervasivo. Las variables de .env (ver .env.example) tienen prioridad.",

  "language": "es-ES",
  "defaultSubject": "matematicas",

  "session": {
    "_comment": "Escucha activa tras la tarjeta del profesor: minutos máximos y longitud de las frases que se analizan.",
    "listenMinutes": 15,
    "minWords": 3,
    "maxWords": 25,
    "allowSubstitutes": true,
    "requireTimeSync": true,
    "checkIntervalSeconds": 30,
    "scheduleRefreshSeconds": 60
  },

  "speech": {
    "_comment": "provider: vosk (local, sin conexión) | google | manual",
    "provider": "vosk",
    "vosk": {
      "python": "./.venv/bin/python",
      "modelPath": "./models/vosk-model-small-es-0.42"
    },
    "credentialsPath": "./credentials/google-cloud-key.json"
  },

  "audio": {
    "device": "plughw:3,0",
    "sampleRate": 16000,
    "channels": 1,
    "maxRecordSeconds": 8
  },

  "voiceResponse": {
    "enabled": false,
    "speed": 150
  },

  "nfc": {
    "_comment": "pcsc: lectores PC/SC (el del proyecto). Si falta el paquete nfc-pcsc (por ejemplo en Windows) se usa el modo teclado: el UID se escribe en la consola.",
    "mode": "pcsc"
  },

  "api": {
    "url": "http://localhost:3000/api",
    "timeoutMs": 3000
  },

  "interpreter": {
    "url": "http://localhost:3000/api/interpret"
  },

  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "dataFile": "./data/db.json"
  },

  "pendingQueueFile": "./logs/pending-missions.json",
  "discardedMissionsFile": "./logs/misiones-descartadas.json",
  "scheduleCacheFile": "./logs/horario.json"
}
