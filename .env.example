# Copia este fichero a .env para sobrescribir config.json sin modificarlo.

# URL de la API de TecnoCRA (o del servidor simulado)
API_URL=http://localhost:3000/api

# Servicio que interpreta las frases del profesor (API simulada, Node-RED o IA)
INTERPRETER_URL=http://localhost:3000/api/interpret

# Dispositivo ALSA del micrófono (ver "arecord -l")
AUDIO_DEVICE=plughw:3,0

# Reconocimiento de voz: vosk (local) | google | manual
SPEECH_PROVIDER=vosk

# Lector NFC: keyboard | pcsc
NFC_MODE=keyboard

# Puerto del servidor simulado
PORT=3000

# Credenciales de Google Cloud (alternativa a speech.credentialsPath)
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json
